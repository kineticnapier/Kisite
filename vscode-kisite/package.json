{
  "name": "kisite-language",
  "displayName": "Kisite",
  "description": "%extension.description%",
  "version": "0.2.1",
  "publisher": "kineticnapier",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:kisite",
    "onCommand:kisite.run",
    "onCommand:kisite.runCompiled"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "kisite",
        "aliases": [
          "Kisite",
          "kisite"
        ],
        "extensions": [
          ".kis"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kisite",
        "scopeName": "source.kisite",
        "path": "./syntaxes/kisite.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kisite",
        "path": "./snippets/kisite.json"
      }
    ],
    "commands": [
      {
        "command": "kisite.run",
        "title": "%command.run%"
      },
      {
        "command": "kisite.runCompiled",
        "title": "%command.runCompiled%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kisite.run",
          "when": "resourceLangId == kisite",
          "group": "navigation@10"
        },
        {
          "command": "kisite.runCompiled",
          "when": "resourceLangId == kisite",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "Kisite",
      "properties": {
        "kisite.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "%config.pythonPath%"
        },
        "kisite.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "%config.interpreterPath%"
        },
        "kisite.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "%config.saveBeforeRun%"
        },
        "kisite.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.diagnostics.enabled%"
        }
      }
    }
  }
}
