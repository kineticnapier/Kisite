{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kisite",
  "scopeName": "source.kisite",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#functionDefinitions" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.kisite",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kisite",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kisite",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.curly.kisite",
          "begin": "“",
          "end": "”",
          "patterns": [
            {
              "name": "constant.character.escape.kisite",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "match": "(?i)(\\bKalivisku\\b)(\\s+)(\\bmusope\\b)(\\s+)(\\bkas\\b)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.kisite" },
            "3": { "name": "keyword.declaration.function.kisite" },
            "5": { "name": "keyword.other.kisite" },
            "7": { "name": "entity.name.function.kisite" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.kisite",
          "match": "(?i)\\b(?:Tuni|Jatuni|Kati|Jakati)\\b"
        },
        {
          "name": "constant.language.kisite",
          "match": "(?i)\\bstdin\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.kisite",
          "match": "(?i)\\b(?:minika|takuta|kineska|tuna|kati)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.kisite",
          "match": "(?i)\\b(?:kipala|pilika|paline|japonavi|ponavi|sum|abs|fill|reverse|resize|truncate|combinations|gcd|lcm|set|array|readint|readints|modint|modpow|modinv|convolution|flush|pi|sin|cos|tan|sqrt|atan2|hypot|floor|ceil|heapify|heappush|heappop|heappeek|bisectleft|bisectright)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kisite",
          "match": "(?i)\\b(?:Palusta|Japalusta|Pilike|Kinise|Kinate|Jasepe)\\b"
        },
        {
          "name": "keyword.declaration.kisite",
          "match": "(?i)\\b(?:Sonome|Kemese|Polike|Putike|Kalivisku|musope)\\b"
        },
        {
          "name": "keyword.operator.word.kisite",
          "match": "(?i)\\b(?:Kisite|kix|kate|kasta|vista|kas|tas|pas|sis|vis|vos)\\b"
        },
        {
          "name": "keyword.other.kisite",
          "match": "(?i)\\bTakute\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.kisite",
          "match": "(?<![A-Za-z0-9_])(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?![A-Za-z0-9_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kisite",
          "match": "//=|<<=|>>=|<=|>=|!=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|[+\\-*/%&|^~<>]"
        },
        {
          "name": "punctuation.terminator.statement.kisite",
          "match": "[.。]"
        }
      ]
    }
  }
}
